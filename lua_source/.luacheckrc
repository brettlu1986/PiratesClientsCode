-- luacheck: ignore

-- Use Lua 5.3 standard libraries
std = "lua53"

ignore = {
    "6..",      -- Ignore Formatting issues (6xx)
    "21./_.*",  -- Ignore unused warnings (21x) if variable is prefixed with underscore
    "212",      -- Ignore unused argument
    "311",      -- Ignore value assigned to a local variable is unused.
    "213",      -- Ignore unused loop variable.
}

-- Warn on global table access unless otherwise
not_globals = { "_G" }

-- Read-and-Write global variables
globals = {
}

