local function ImportExtendedCheck(szCheckFile)
    package.preload[szCheckFile] = nil
    package.loaded[szCheckFile] = nil
    local luacheck_func = require(szCheckFile)
    for _, v in pairs(luacheck_func) do
        table.insert(read_globals, v)
    end

end

ImportExtendedCheck("luacheck_func")
